# 非交互式 shell 直接退出。sshd 执行远程命令时也会读这个文件，
# 而末尾的 exec fish 会顶掉 scp / rsync / sftp 的传输进程。
# 用 $- 而不是 $SSH_TTY：VNC、云控制台、本机终端同样是交互式的。
case $- in
  *i*) ;;
    *) return ;;
esac

export PATH=$HOME/.local/bin:$PATH

_ok()   { if [ -t 2 ]; then printf '  \033[32m\xe2\x9c\x93\033[0m %s\n' "$1" >&2; else printf '  \xe2\x9c\x93 %s\n' "$1" >&2; fi; }
_miss() { if [ -t 2 ]; then printf '  \033[31m\xe2\x9c\x97\033[0m %s\n' "$1" >&2; else printf '  \xe2\x9c\x97 %s\n' "$1" >&2; fi; }
# [ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # boot up x-cmd.
# export PATH=/root/.x-cmd.root/local/data/pkg/sphere/X/l/j/h/bin:$PATH
if [ -f "$HOME/.x-cmd.root/X" ]; then
  _ok x-cmd
  . "$HOME/.x-cmd.root/X"   # Boot up x-cmd
  export PATH=$HOME/.x-cmd.root/local/data/pkg/sphere/X/l/j/h/bin:$PATH  # Modify PATH for chezmoi and fzf and starship
else
  _miss x-cmd
fi

if command -v starship > /dev/null 2>&1; then
    _ok starship
    eval "$(starship init bash)"
else
    _miss starship
fi
if command -v $HOME/.local/bin/zoxide > /dev/null 2>&1; then
    _ok zoxide
    eval "$($HOME/.local/bin/zoxide init --cmd cd bash)"
else
    _miss zoxide
fi
# cdi 会自动从 PATH 中找 fzf,不需要单独设置下面的
# eval "$(fzf --bash)"

# 装了 fish 就直接切过去（exec 替换当前进程，退出 fish 即退出登录）
if command -v fish >/dev/null 2>&1; then
  exec fish
fi
